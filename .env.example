# Environment Configuration
# Copy this file to .env and modify as needed

# Server
HOST=0.0.0.0
PORT=8000

# Model Configuration
MODEL_NAME=Qwen/Qwen-VL
MODEL_CACHE_DIR=/root/autodl-tmp/models
DEVICE=cuda
DTYPE=bf16

# HuggingFace Token (optional, for private models)
HF_TOKEN=

# API Security
API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=/root/autodl-tmp/logs/api_server.log

# Performance
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4
